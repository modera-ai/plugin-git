{
  "apiVersion": 1,
  "activationScope": "scoped",
  "extensions": ["panel", "tool.approval"],
  "id": "modera.git",
  "name": "Change Review",
  "version": "0.1.0",
  "description": "Review file changes in any workspace, with optional Git repository tools.",
  "author": "Modera",
  "category": "development",
  "icon": "git-branch",
  "main": "dist/index.cjs",
  "frontends": { "review": { "root": "dist/ui", "entry": "index.html" } },
  "permissions": ["workspace.read", "workspace.write", "process.spawn"],
  "tools": [
    {
      "id": "git_inspect",
      "title": "Inspect Git repository",
      "description": "Read repository status, diff, history or local branches. Paths are literal repository-relative paths. No remote access.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": ["status", "diff", "log", "branches"]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "staged": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": ["action"]
      },
      "requiredPermissions": ["workspace.read", "process.spawn"],
      "presentation": {
        "icon": "code",
        "tone": "blue",
        "kind": "search",
        "targets": ["action"]
      }
    },
    {
      "id": "git_change",
      "title": "Change Git repository",
      "description": "Stage or unstage explicit files, commit the current index, or create a new branch. Review status and diff first. No reset, clean, force push or checkout of existing branches.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": ["stage", "unstage", "commit", "create_branch"]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": ["action"]
      },
      "requiredPermissions": [
        "workspace.read",
        "workspace.write",
        "process.spawn"
      ],
      "presentation": {
        "icon": "code",
        "tone": "amber",
        "kind": "edit",
        "targets": ["action"]
      }
    }
  ],
  "locales": {
    "zh-CN": {
      "name": "变更审查",
      "description": "普通文件夹也支持每轮变更审查；Git 仓库额外支持版本管理。"
    }
  },
  "contributions": ["runChanges"]
}
